# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/317booking"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# IANA timezone for show times, availability, and iCal. Docker Compose publishes the app on :3001.
APP_TIMEZONE="America/Indiana/Indianapolis"
# Optional directory for venue logo uploads. Defaults to ./uploads (outside public/).
UPLOAD_DIR=""

# Stripe (Phase 2)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Email / SMTP
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
# Set to "true" for implicit TLS (port 465), leave unset or "false" for STARTTLS
SMTP_SECURE="false"
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="317 Booking <noreply@yourdomain.com>"

# StudioSync integration (optional)
# Base URL of the StudioSync instance (no trailing slash) — used for outbound webhooks.
STUDIOSYNC_URL="http://localhost:8000"
# Shared HMAC secret for signing/verifying webhooks in both directions.
# Generate with: openssl rand -hex 32
# Must match BOOKING_317_WEBHOOK_SECRET in StudioSync's .env
STUDIOSYNC_WEBHOOK_SECRET=""
